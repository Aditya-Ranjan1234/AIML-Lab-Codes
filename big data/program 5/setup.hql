-- Program 5 - Create and Load Table
CREATE TABLE movie_log(
    MOVIE_ID STRING,
    MOVIE_TITLE STRING,
    USER_ID STRING,
    RATINGS FLOAT,
    GENRE_ID STRING,
    RECOMMENDED STRING,
    ACTIVITY INT
)
ROW FORMAT DELIMITED
FIELDS TERMINATED BY ','
STORED AS TEXTFILE;

LOAD DATA LOCAL INPATH 'Dataset5.csv' INTO TABLE movie_log;
